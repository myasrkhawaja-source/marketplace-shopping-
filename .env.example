# ============================================================
#  Beauty Marketplace - example environment file
#  Copy this file to  server/.env  and fill your own values.
# ============================================================

# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database ----
# Option 1 (local MongoDB):   mongodb://127.0.0.1:27017/beauty_marketplace
# Option 2 (MongoDB Atlas):   mongodb+srv://<user>:<password>@<cluster>/beauty_marketplace
MONGODB_URI=mongodb://127.0.0.1:27017/beauty_marketplace

# Set to true to run the API on a temporary in-memory MongoDB
# (great for a demo / for machines where MongoDB is not installed).
USE_MEMORY_DB=false

# ---- Authentication ----
JWT_SECRET=change_this_super_secret_key
JWT_EXPIRES_IN=30d

# ---- Uploads ----
MAX_FILE_UPLOAD_MB=5

# ---- Client ----
CLIENT_URL=http://localhost:5173
