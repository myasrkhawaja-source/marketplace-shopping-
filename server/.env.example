# ============================================================
#  Beauty Marketplace API - environment variables
#  Copy to  server/.env  and edit.
# ============================================================
NODE_ENV=development
PORT=5000

# mongodb://127.0.0.1:27017/beauty_marketplace   (local)
# mongodb+srv://USER:PASS@cluster.mongodb.net/beauty_marketplace   (Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/beauty_marketplace

# true  => the API runs on a temporary in-memory MongoDB,
#          so the project works even without installing MongoDB.
#          The demo data is inserted automatically on the first start.
# false => use the real database above (recommended for the final demo:
#          install MongoDB or use Atlas, then run: npm run seed)
USE_MEMORY_DB=true

# set to false to disable the automatic demo data insertion
AUTO_SEED=true

JWT_SECRET=change_this_super_secret_key
JWT_EXPIRES_IN=30d

MAX_FILE_UPLOAD_MB=5

CLIENT_URL=http://localhost:5173
